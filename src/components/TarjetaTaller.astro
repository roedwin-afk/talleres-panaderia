---
// src/components/talleres/TarjetaTaller.astro
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import type { imageNames } from "../data/content";
import imagenTorta from "../assets/torta.jpg";

interface Props {
    taller: CollectionEntry<"talleres">;
    items: imageNames[];
}

const { taller, items } = Astro.props;
const {
    nombre,
    categoria,
    fecha,
    horarioInicio,
    horarioFin,
    lugar,
    instructor,
    instructorGenero,
    nivel,
    cuposDisponibles,
    cuposTotales,
    precio,
    precioPreventa,
    imagenName,
    imagenAlt,
} = taller.data;

// Porcentaje de cupos disponibles respecto al total
const porcentajeCupos = (cuposDisponibles / cuposTotales) * 100;

// Umbrales: verde >50%, amarillo 30%-50%, rojo <30%
let nivelDisponibilidad: "high" | "medium" | "low";
let etiquetaCupos: string;

if (porcentajeCupos > 50) {
    nivelDisponibilidad = "high";
    etiquetaCupos = `${cuposDisponibles} disponibles`;
} else if (porcentajeCupos >= 30) {
    nivelDisponibilidad = "medium";
    etiquetaCupos = `Quedan ${cuposDisponibles} cupos`;
} else {
    nivelDisponibilidad = "low";
    etiquetaCupos = `¡Últimos ${cuposDisponibles} cupos!`;
}

const fechaFormateada = fecha.toLocaleDateString("es-SV", {
    weekday: "short",
    day: "numeric",
    month: "long",
    timeZone: "UTC",
});

const formateadorUSD = new Intl.NumberFormat("en-US", {
    style: "currency",
    currency: "USD",
});
const precioFormateado = formateadorUSD.format(precio);
const precioPreventaFormateado = precioPreventa
    ? formateadorUSD.format(precioPreventa)
    : null;

const etiquetaInstructor =
    instructorGenero === "f" ? "Instructora" : "Instructor";

const imagenSrc =
    items.find((item) => item.name === imagenName)?.imagen ?? imagenTorta;

const base = import.meta.env.BASE_URL;
---

<article class="card">
    <div class="card-img-placeholder">
        <Image
            src={imagenSrc}
            alt={imagenAlt}
            width={480}
            height={320}
            loading="lazy"
        />
    </div>

    <div class="card-content">
        <div class="card-meta">
            <span class="badge badge-nivel">
                <svg
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                >
                    <line x1="4" y1="20" x2="4" y2="14"></line>
                    <line x1="12" y1="20" x2="12" y2="9"></line>
                    <line x1="20" y1="20" x2="20" y2="4"></line>
                </svg>
                {nivel}
            </span>

            <span class={`badge ${nivelDisponibilidad}`}>
                <svg
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                    <circle cx="9" cy="7" r="4" />
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                    <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                </svg>
                {etiquetaCupos}
            </span>
        </div>

        <h3 class="card-title">{nombre}</h3>

        <div class="card-instructor">
            <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
            >
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                <circle cx="12" cy="7" r="4"></circle>
            </svg>
            {etiquetaInstructor}: {instructor}
        </div>

        <ul class="card-details-list">
            <li><span>Fecha:</span> <span>{fechaFormateada}</span></li>
            <li>
                <span>Horario:</span>
                <span>{horarioInicio} - {horarioFin}</span>
            </li>
            <li><span>Lugar:</span> <span>{lugar}</span></li>
        </ul>

        <div class="card-price-block">
            {
                precioPreventaFormateado ? (
                    <>
                        <span class="card-price-preventa">
                            {precioPreventaFormateado}
                            <span class="badge-preventa">Preventa</span>
                        </span>
                        <span class="card-price-regular">
                            {precioFormateado} reservando con el 50%
                        </span>
                    </>
                ) : (
                    <span class="card-price-preventa">{precioFormateado}</span>
                )
            }
        </div>

        <div class="card-actions">
            <a
                href={`${base}talleres/${categoria}/${taller.id}`}
                class="btn btn-outline">Ver detalles</a
            >
            {
                cuposDisponibles > 0 ? (
                    <a
                        href={`${base}talleres/${categoria}/${taller.id}/#registration`}
                        class="btn btn-primary"
                    >
                        Inscribirme
                    </a>
                ) : (
                    <span class="btn btn-disabled" aria-disabled="true">
                        Sin cupos
                    </span>
                )
            }
        </div>
    </div>
</article>

<style>
    .card {
        background-color: var(--bg-surface);
        border-radius: var(--radius-lg);
        overflow: hidden;
        box-shadow: var(--shadow-md);
        transition:
            transform var(--transition-speed),
            box-shadow var(--transition-speed);
        display: flex;
        flex-direction: column;
        border: 1px solid var(--border-light);
        /* Los @container de abajo miden el ancho de la card, no el viewport */
        container-type: inline-size;
    }

    .card:hover {
        transform: translateY(-5px);
        box-shadow: var(--shadow-lg);
    }

    .card-img-placeholder {
        height: 200px;
        background-color: var(--bg-surface-alt);
    }

    .card-img-placeholder img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .card-content {
        padding: var(--space-md);
        display: flex;
        flex-direction: column;
        flex-grow: 1;
    }

    .card-meta {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: var(--space-xs);
        margin-bottom: var(--space-xs);
    }

    .card-title {
        font-size: 1.5rem;
        margin-bottom: var(--space-xs);
    }

    .card-instructor {
        color: var(--text-muted);
        font-size: 0.95rem;
        margin-bottom: var(--space-sm);
        display: flex;
        align-items: center;
        gap: 5px;
    }

    .card-details-list {
        list-style: none;
        margin-bottom: var(--space-md);
        padding-top: var(--space-sm);
        border-top: 1px solid var(--border-light);
    }

    .card-details-list li {
        display: flex;
        justify-content: space-between;
        gap: var(--space-xs);
        margin-bottom: 0.5rem;
        font-size: 0.95rem;
    }

    .card-details-list li span:first-child {
        color: var(--text-muted);
    }

    .card-details-list li span:last-child {
        font-weight: 600;
        text-align: right;
    }

    .card-price-block {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        margin-bottom: var(--space-sm);
    }

    .card-price-preventa {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--brand-primary);
    }

    .badge-preventa {
        font-size: 0.65rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        color: #fff;
        background-color: var(--status-available);
        padding: 0.15rem 0.4rem;
        border-radius: var(--radius-md);
    }

    .card-price-regular {
        font-size: 0.8rem;
        color: var(--text-muted);
    }

    .card-actions {
        margin-top: auto;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--space-xs);
    }

    .badge.high {
        background-color: rgba(34, 197, 94, 0.12);
        color: #16a34a;
    }

    .badge.medium {
        background-color: rgba(234, 179, 8, 0.14);
        color: #b45309;
    }

    .badge.low {
        background-color: rgba(239, 68, 68, 0.12);
        color: #dc2626;
    }

    /* Modo compacto: se activa según el ancho de la card, no de la ventana.
       Reemplaza al antiguo @media (max-width: 768px) de .card-actions. */
    @container (max-width: 340px) {
        .card-img-placeholder {
            height: 160px;
        }

        .card-content {
            padding: var(--space-sm);
        }

        .card-meta {
            justify-content: flex-start;
        }

        .card-title {
            font-size: 1.15rem;
            line-height: 1.3;
        }

        .card-details-list li {
            flex-direction: column;
            gap: 0.1rem;
            margin-bottom: 0.6rem;
        }

        .card-details-list li span:last-child {
            text-align: left;
        }

        .card-price-block {
            align-items: flex-start;
        }

        .card-actions {
            grid-template-columns: 1fr;
        }
    }
</style>