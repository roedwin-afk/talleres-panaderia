---
// src/components/ZohoFormulario.astro
interface Props {
  formPerma: string;
  formUrlBase?: string;
  ariaLabel?: string;
  height?: string;
  width?: string;
}

const {
  formPerma,
  formUrlBase = 'https://forms.zohopublic.com/promaica/form/RegistrodeTalleresdePanadera/formperma',
  ariaLabel = 'Registro de Talleres de Panadería',
  height = '784px',
  width = '90%',
} = Astro.props;

const divId = `zf_div_${formPerma}`;
const iframeSrcBase = `${formUrlBase}/${formPerma}?zf_rszfm=1`;
---

<div id={divId}></div>

<script is:inline define:vars={{ divId, iframeSrcBase, ariaLabel, height, width }}>
  (function () {
    try {
      var f = document.createElement('iframe');
      var ifrmSrc = iframeSrcBase;

      try {
        if (typeof ZFAdvLead != 'undefined' && typeof zfutm_zfAdvLead != 'undefined') {
          for (var i = 0; i < ZFAdvLead.utmPNameArr.length; i++) {
            var utmPm = ZFAdvLead.utmPNameArr[i];
            utmPm = (ZFAdvLead.isSameDomian && ZFAdvLead.utmcustPNameArr.indexOf(utmPm) == -1) ? 'zf_' + utmPm : utmPm;
            var utmVal = zfutm_zfAdvLead.zfautm_gC_enc(ZFAdvLead.utmPNameArr[i]);
            if (typeof utmVal !== 'undefined' && utmVal != '') {
              ifrmSrc += (ifrmSrc.indexOf('?') > 0 ? '&' : '?') + utmPm + '=' + utmVal;
            }
          }
        }
        if (typeof ZFLead !== 'undefined' && typeof zfutm_zfLead !== 'undefined') {
          for (var j = 0; j < ZFLead.utmPNameArr.length; j++) {
            var utmPm2 = ZFLead.utmPNameArr[j];
            var utmVal2 = zfutm_zfLead.zfutm_gC_enc(ZFLead.utmPNameArr[j]);
            if (typeof utmVal2 !== 'undefined' && utmVal2 != '') {
              ifrmSrc += (ifrmSrc.indexOf('?') > 0 ? '&' : '?') + utmPm2 + '=' + utmVal2;
            }
          }
        }
        if (!/[?&]referrername=/.test(ifrmSrc)) {
          var rfr = window.location.href;
          try {
            rfr = window.self !== window.top
              ? window.top.location.href
              : (/^https?:\/\/[\w.-]+\.[a-zA-Z]{2,}/i.test(rfr) ? rfr : '');
          } catch (e) {}
          if (rfr && rfr !== '') {
            if (rfr.length > 1800) {
              var qi = rfr.indexOf('?');
              if (qi > -1) rfr = rfr.substring(0, qi);
              if (rfr.length > 1800) rfr = rfr.substring(0, 1800);
            }
            ifrmSrc += (ifrmSrc.indexOf('?') > 0 ? '&' : '?') + 'referrername=' + encodeURIComponent(rfr);
          }
        }
      } catch (e) {}

      f.src = ifrmSrc;
      f.style.border = 'none';
      f.style.height = height;
      f.style.width = width;
      f.style.transition = 'all 0.5s ease';
      f.setAttribute('aria-label', ariaLabel);

      var d = document.getElementById(divId);
      d.appendChild(f);

      window.addEventListener('message', function (event) {
        var evntData = event.data;
        if (evntData && evntData.constructor == String) {
          var parts = evntData.split('|');
          if (parts.length == 2 || parts.length == 3) {
            var zfPerma = parts[0];
            var newHeight = (parseInt(parts[1], 10) + 15) + 'px';
            var iframe = document.getElementById(divId).getElementsByTagName('iframe')[0];
            if (iframe.src.indexOf('formperma') > 0 && iframe.src.indexOf(zfPerma) > 0) {
              var prevHeight = iframe.style.height;
              var scrollTo = false;
              if (parts.length == 3) {
                iframe.scrollIntoView();
                scrollTo = true;
              }
              if (prevHeight != newHeight) {
                if (scrollTo) {
                  setTimeout(function () { iframe.style.height = newHeight; }, 500);
                } else {
                  iframe.style.height = newHeight;
                }
              }
            }
          }
        }
      }, false);
    } catch (e) {}
  })();
</script>