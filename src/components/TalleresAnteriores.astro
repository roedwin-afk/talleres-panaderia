---
import type { TallerAnterior } from "../data/content";
interface Props {
  items: TallerAnterior[];
}
const { items } = Astro.props;
---

<section id="talleres-anteriores" class="galeria-section">
  <div class="container">
    <div class="section-header">
      <span class="eyebrow">Así se viven nuestros talleres</span>
      <h2>Aprende haciendo y conoce equipos profesionales</h2>
      <p>
        Vive una experiencia práctica donde aprenderás nuevas preparaciones
        mientras conoces maquinaria que facilita y agiliza el trabajo.
      </p>
    </div>

    <div class="grid galeria-grid">
      {
        items.map((item) => (
          <figure class="galeria-item">
            <div
              class="galeria-imagen-wrap"
              style={`background-image: url('${item.imagen}');`}
            >
              <img src={item.imagen} alt={item.titulo} loading="lazy" />
            </div>
            <figcaption>{item.titulo}</figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .galeria-section {
    padding: var(--space-lg) 0;
  }

  .eyebrow {
    display: block;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brand-primary);
    margin-bottom: var(--space-xs);
  }

  .galeria-grid {
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }

  .galeria-item {
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .galeria-item img {
    position: relative;
    z-index: 1;
    max-height: 220px;
    max-width: 100%;
    width: auto;
    height: auto;
    margin: 0 auto;
    object-fit: contain;
    display: block;
  }

  .galeria-imagen-wrap {
    position: relative;
    height: 220px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background-size: cover;
    background-position: center;
  }

  .galeria-imagen-wrap::before {
    content: "";
    position: absolute;
    inset: 0;
    background: inherit;
    background-size: cover;
    background-position: center;
    filter: blur(14px) brightness(0.7);
    transform: scale(1.15); /* evita bordes borrosos visibles por el blur */
    z-index: 0;
  }

  .galeria-item figcaption {
    padding: var(--space-sm);
    background-color: var(--bg-surface);
    font-weight: 600;
    font-size: 0.95rem;
    text-align: center;
    flex-grow: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }
</style>