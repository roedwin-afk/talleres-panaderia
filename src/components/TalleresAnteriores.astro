---
import { Image, getImage } from "astro:assets";
import type { TallerAnterior } from "../data/content";

interface Props {
  items: TallerAnterior[];
}
const { items } = Astro.props;

// Pre-generamos versiones optimizadas (más grandes) de cada foto para el modal,
// en build time. El thumbnail usa <Image /> directamente más abajo.
const galerias = await Promise.all(
  items.map(async (item) => {
    const fotos = item.imagenes?.length ? item.imagenes : [item.imagen];
    const optimizadas = await Promise.all(
      fotos.map((foto) => getImage({ src: foto, width: 1200, format: "webp" }))
    );
    return optimizadas.map((img) => img.src);
  })
);
---

<section id="talleres-anteriores" class="galeria-section">
  <div class="container">
    <div class="section-header">
      <span class="eyebrow">Así se viven nuestros talleres</span>
      <h2>Aprende haciendo y conoce equipos profesionales</h2>
      <p>
        Vive una experiencia práctica donde aprenderás nuevas preparaciones
        mientras conoces maquinaria que facilita y agiliza el trabajo.
      </p>
    </div>

    <div class="grid galeria-grid">
      {
        items.map((item, i) => (
          <figure class="galeria-item">
            <button
              type="button"
              class="galeria-trigger"
              data-index={i}
              data-titulo={item.titulo}
              data-imagenes={JSON.stringify(galerias[i])}
              aria-label={`Ver galería de ${item.titulo}`}
            >
              <div class="galeria-imagen-wrap">
                <Image
                  src={item.imagen}
                  alt={item.titulo}
                  width={480}
                  height={320}
                  loading="lazy"
                />
                <div class="galeria-overlay" aria-hidden="true" />
                {galerias[i].length > 1 && (
                  <span class="galeria-badge">+{galerias[i].length} fotos</span>
                )}
                {galerias[i].length === 1 && (
                  <span class="galeria-badge">Ver foto</span>
                )}
                <figcaption>{item.titulo}</figcaption>
              </div>
            </button>
          </figure>
        ))
      }
    </div>
  </div>

  <!-- Modal / Lightbox (sin cambios respecto a la versión anterior) -->
  <div id="galeria-modal" class="galeria-modal" hidden>
    <div class="galeria-modal-backdrop" data-close></div>
    <div class="galeria-modal-content" role="dialog" aria-modal="true" aria-label="Galería de fotos">
      <button type="button" class="galeria-modal-close" data-close aria-label="Cerrar">
        &times;
      </button>
      <button type="button" class="galeria-modal-nav galeria-modal-prev" aria-label="Foto anterior">
        &#8249;
      </button>
      <div class="galeria-modal-body">
        <img id="galeria-modal-img" src="" alt="" />
        <p id="galeria-modal-titulo" class="galeria-modal-titulo"></p>
        <p id="galeria-modal-counter" class="galeria-modal-counter"></p>
      </div>
      <button type="button" class="galeria-modal-nav galeria-modal-next" aria-label="Foto siguiente">
        &#8250;
      </button>
    </div>
  </div>
</section>

<style>
  .galeria-section {
    padding: var(--space-lg) 0;
  }

  .eyebrow {
    display: block;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brand-primary);
    margin-bottom: var(--space-xs);
  }

  .galeria-grid {
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }

  .galeria-item {
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition-speed), box-shadow var(--transition-speed);
  }

  .galeria-item:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  .galeria-trigger {
    display: block;
    width: 100%;
    padding: 0;
    border: none;
    background: none;
    cursor: pointer;
  }

  .galeria-imagen-wrap {
    position: relative;
    height: 260px;
    overflow: hidden;
  }

  .galeria-imagen-wrap :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 25%; /* un poco más de contexto que "top" puro, menos zoom */
    display: block;
    transition: transform 0.35s ease;
  }

  .galeria-trigger:hover .galeria-imagen-wrap :global(img) {
    transform: scale(1.05);
  }

  .galeria-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.8) 0%,
      rgba(0, 0, 0, 0.25) 45%,
      transparent 70%
    );
  }

  .galeria-item figcaption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: var(--space-sm);
    color: var(--text-light);
    font-weight: 700;
    font-size: 0.95rem;
    text-align: left;
  }

  .galeria-badge {
    position: absolute;
    top: var(--space-xs);
    right: var(--space-xs);
    background-color: rgba(0, 0, 0, 0.55);
    color: var(--text-light);
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
    backdrop-filter: blur(2px);
  }

  /* --- Modal / Lightbox --- */
  .galeria-modal {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-md);
  }

  .galeria-modal[hidden] {
    display: none;
  }

  .galeria-modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.85);
  }

  .galeria-modal-content {
    position: relative;
    z-index: 1;
    max-width: min(92vw, 900px);
    max-height: 90vh;
  }

  .galeria-modal-body {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
  }

  #galeria-modal-img {
    display: block;
    max-width: 100%;
    max-height: 72vh;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg, 0 20px 40px rgba(0, 0, 0, 0.4));
  }

  .galeria-modal-titulo {
    color: var(--text-light);
    font-weight: 700;
    text-align: center;
  }

  .galeria-modal-counter {
    color: rgba(255, 255, 255, 0.65);
    font-size: 0.85rem;
  }

  .galeria-modal-close {
    position: fixed;
    top: var(--space-sm);
    right: var(--space-sm);
    z-index: 2;
    background: rgba(255, 255, 255, 0.1);
    border: none;
    color: var(--text-light);
    font-size: 1.8rem;
    line-height: 1;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .galeria-modal-close:hover {
    background: rgba(255, 255, 255, 0.25);
  }

  .galeria-modal-nav {
    position: fixed;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    background: rgba(255, 255, 255, 0.1);
    border: none;
    color: var(--text-light);
    font-size: 2rem;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .galeria-modal-nav:hover {
    background: rgba(255, 255, 255, 0.25);
  }

  .galeria-modal-nav[hidden] {
    display: none;
  }

  .galeria-modal-prev {
    left: var(--space-sm);
  }

  .galeria-modal-next {
    right: var(--space-sm);
  }

  @media (max-width: 640px) {
    .galeria-modal-nav {
      width: 2.5rem;
      height: 2.5rem;
      font-size: 1.5rem;
    }
  }
</style>

<script is:inline>
  const modal = document.getElementById("galeria-modal");
  const modalImg = document.getElementById("galeria-modal-img");
  const modalTitulo = document.getElementById("galeria-modal-titulo");
  const modalCounter = document.getElementById("galeria-modal-counter");
  const btnClose = document.querySelectorAll("[data-close]");
  const btnPrev = document.querySelector(".galeria-modal-prev");
  const btnNext = document.querySelector(".galeria-modal-next");
  const triggers = document.querySelectorAll(".galeria-trigger");

  let imagenesActuales = [];
  let tituloActual = "";
  let indiceActual = 0;
  let triggerQueAbrio = null;

  function render() {
    if (!modalImg || !modalTitulo || !modalCounter) return;
    modalImg.src = imagenesActuales[indiceActual];
    modalImg.alt = tituloActual;
    modalTitulo.textContent = tituloActual;
    const multiple = imagenesActuales.length > 1;
    modalCounter.textContent = multiple
      ? `${indiceActual + 1} / ${imagenesActuales.length}`
      : "";
    btnPrev?.toggleAttribute("hidden", !multiple);
    btnNext?.toggleAttribute("hidden", !multiple);
  }

  function abrirModal(imagenes, titulo, trigger) {
    imagenesActuales = imagenes;
    tituloActual = titulo;
    indiceActual = 0;
    triggerQueAbrio = trigger ?? null;
    render();
    modal?.removeAttribute("hidden");
    document.body.style.overflow = "hidden";
  }

  function cerrarModal() {
    modal?.setAttribute("hidden", "");
    document.body.style.overflow = "";
    triggerQueAbrio?.focus();
    triggerQueAbrio = null;
  }

  function irAnterior() {
    if (!imagenesActuales.length) return;
    indiceActual =
      (indiceActual - 1 + imagenesActuales.length) % imagenesActuales.length;
    render();
  }

  function irSiguiente() {
    if (!imagenesActuales.length) return;
    indiceActual = (indiceActual + 1) % imagenesActuales.length;
    render();
  }

  triggers.forEach((trigger) => {
    trigger.addEventListener("click", () => {
      let imagenes = [];
      try {
        imagenes = JSON.parse(trigger.getAttribute("data-imagenes") || "[]");
      } catch {
        imagenes = [];
      }
      const titulo = trigger.getAttribute("data-titulo") || "";
      if (!imagenes.length) return;
      abrirModal(imagenes, titulo, trigger);
    });
  });

  btnClose.forEach((btn) => btn.addEventListener("click", cerrarModal));
  btnPrev?.addEventListener("click", irAnterior);
  btnNext?.addEventListener("click", irSiguiente);

  document.addEventListener("keydown", (e) => {
    if (modal?.hasAttribute("hidden")) return;
    if (e.key === "Escape") cerrarModal();
    if (e.key === "ArrowLeft") irAnterior();
    if (e.key === "ArrowRight") irSiguiente();
  });
</script>