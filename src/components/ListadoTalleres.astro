---
import { getCollection } from "astro:content";
import TarjetaTaller from "./TarjetaTaller.astro";
import { contenidoPorCategoria } from "../data/content";

interface Props {
  categoria: string;
}

const { categoria } = Astro.props;

const ahora = new Date();

const talleresEntries = await getCollection(
  "talleres",
  ({ data }) => data.categoria === categoria && data.fecha >= ahora,
);

const talleresOrdenados = talleresEntries.sort(
  (a, b) => a.data.fecha.valueOf() - b.data.fecha.valueOf(),
);
---

<section id="workshops" class="workshops-section">
  <div class="container">
    <div class="section-header">
      <h2>Cartelera de Talleres</h2>
      <p>
        Descubre nuestros próximos talleres prácticos y reserva tu espacio.
        Trabajamos con grupos reducidos para que puedas participar en las
        preparaciones, resolver tus dudas y conocer de cerca el
        funcionamiento de maquinaria profesional.
      </p>
      <p class="subtexto-destacado">
        Elige el taller que más se adapte a lo que quieres aprender o
        incorporar a tu emprendimiento.
      </p>
    </div>

    <div class="grid">
      {
        talleresOrdenados.map((taller) => (
          <TarjetaTaller
            taller={taller}
            items={contenidoPorCategoria[categoria].imageNames}
          />
        ))
      }
    </div>
  </div>
</section>

<style>
  .workshops-section {
    padding: var(--space-lg) 0;
  }

  .subtexto-destacado {
    font-weight: 700;
    color: var(--brand-primary);
    margin-top: var(--space-xs);
  }

  /* Ancho mínimo cómodo por card. auto-fill conserva las columnas
     vacías, así que una sola card no se estira al ancho completo. */
  .workshops-section .grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: var(--space-md);
  align-items: stretch;
}

@media (max-width: 768px) {
  .workshops-section .grid {
    grid-template-columns: 1fr;
    gap: var(--space-lg);
  }
}
</style>