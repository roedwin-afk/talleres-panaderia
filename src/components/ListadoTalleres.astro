---
// src/components/talleres/ListadoTalleres.astro
import { getCollection } from "astro:content";
import TarjetaTaller from "./TarjetaTaller.astro";

interface Props {
  categoria: string;
}

const { categoria } = Astro.props;

const talleresEntries = await getCollection(
  "talleres",
  ({ data }) => data.categoria === categoria,
);

const talleresOrdenados = talleresEntries.sort(
  (a, b) => a.data.fecha.valueOf() - b.data.fecha.valueOf(),
);
---

<section id="workshops" class="workshops-section">
  <div class="container">
    <div class="section-header">
      <h2>Cartelera de Talleres</h2>
      <p>
        Descubre nuestros próximos talleres prácticos y reserva tu espacio.
        Trabajamos con grupos reducidos para que puedas participar en las
        preparaciones, resolver tus dudas y conocer de cerca el
        funcionamiento de maquinaria profesional.
      </p>
      <p class="subtexto-destacado">
        Elige el taller que más se adapte a lo que quieres aprender o
        incorporar a tu emprendimiento.
      </p>
    </div>

    <div class="grid">
      {talleresOrdenados.map((taller) => <TarjetaTaller taller={taller} />)}
    </div>
  </div>
</section>

<style>
  .workshops-section {
    padding: var(--space-lg) 0;
  }

  .subtexto-destacado {
    font-weight: 700;
    color: var(--brand-primary);
    margin-top: var(--space-xs);
  }

  @media (max-width: 600px) {
    .workshops-section .grid {
      gap: var(--space-lg);
    }
  }
</style>