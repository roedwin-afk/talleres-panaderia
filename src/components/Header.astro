---
import { Image } from "astro:assets";
import logo from "../assets/editable-logo-equipoypartes.webp";
import { menu } from "../data/categorias";
import { categorias } from "../data/categorias";
import { contenidoPorCategoria } from "../data/content";

interface Props {
  nombreEmpresa: string;
}

const { nombreEmpresa } = Astro.props;
const base = import.meta.env.BASE_URL;

const tallerActual = Astro.url.pathname.split("/talleres/")[1];
console.log("Header tallerActual:", tallerActual);
console.log("es contacto?", tallerActual === undefined);
---

<header id="site-header">
  <div class="container header-content">
    <div class="header-top">
      <button
        id="nav-toggle"
        class="nav-toggle"
        aria-label="Abrir menú"
        aria-expanded="false"
      >
        <span></span><span></span><span></span>
      </button>

      <a href={base} class="logo">
        <Image
          src={logo}
          alt={nombreEmpresa}
          width={200}
          height={184}
          class="navbar__logo-img"
        />
      </a>
    </div>

    <nav id="main-nav" class="main-nav">
      <ul>
        {
          !(tallerActual === undefined)
            ? menu.map((cat) => {
                //const disponible = !!contenidoPorCategoria[cat.id];
                const href = `${base}talleres/${tallerActual}#${cat.tag}`;
                const activo = Astro.url.pathname.startsWith(href);
                return (
                  <li>
                    <a href={href} class:list={["nav-link", { activo }]}>
                      {cat.nombre}
                    </a>
                  </li>
                );
              })
            : categorias.map((cat) => {
                const href = `${base}talleres/${cat.id}/`;
                const activo = Astro.url.pathname.startsWith(href);
                return (
                  <li>
                    <a href={href} class:list={["nav-link", { activo }]}>
                      {cat.nombre}
                    </a>
                  </li>
                );
              })
        }
        <li>
          <a
            href={`${base}contacto/`}
            class:list={[
              "nav-link",
              { activo: Astro.url.pathname.startsWith(`${base}contacto`) },
            ]}
          >
            Contacto
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  header {
    background-color: var(--bg-surface);
    padding: var(--space-sm) 0;
    box-shadow: var(--shadow-sm);
    position: sticky;
    top: 0;
    z-index: 100;
    transition: padding 0.3s ease;
  }

  header.scrolled {
    padding: 0;
  }

  .header-content {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .header-top {
    position: relative;
    width: 100%;
    max-height: 9rem;
    min-height: 3.5rem;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
    transition:
      max-height 0.3s ease,
      min-height 0.3s ease;
  }

  .logo {
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    opacity: 1;
    transform: translateY(0) scale(1);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }

  .navbar__logo-img {
    display: block;
    height: 7rem;
    width: auto;
  }

  /* --- Estado "scrolled": el header se comprime al mínimo indispensable --- */
  header.scrolled .header-top {
    max-height: 2.75rem;
    min-height: 2.75rem;
  }

  header.scrolled .logo {
    opacity: 0;
    transform: translateY(-12px) scale(0.9);
    pointer-events: none;
  }

  .nav-toggle {
    display: flex;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    position: absolute;
    top: 50%;
    left: 0.5rem;
    transform: translateY(-50%);
    z-index: 10;
  }

  .nav-toggle span {
    width: 24px;
    height: 2px;
    background-color: var(--text-main);
  }

  /* --- El menú es un dropdown flotante en mobile: no empuja el contenido --- */
  .main-nav {
    display: none;
  }

  .main-nav.open {
    display: block;
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    background: var(--bg-surface);
    box-shadow: var(--shadow-md, 0 8px 20px rgba(0, 0, 0, 0.15));
    padding: var(--space-md);
    z-index: 99;
    border-top: 1px solid var(--border, rgba(0, 0, 0, 0.08));
  }

  .main-nav.open ul {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
    list-style: none;
  }

  .nav-link {
    color: var(--text-main);
    text-decoration: none;
    font-weight: 600;
    padding: 0.4rem 0;
    border-bottom: 2px solid transparent;
    transition:
      border-color var(--transition-speed),
      color var(--transition-speed);
  }

  .nav-link:hover {
    color: var(--brand-primary);
  }

  .nav-link.activo {
    color: var(--brand-primary);
    border-bottom-color: var(--brand-primary);
  }

  .nav-link--disabled {
    color: var(--text-muted);
    cursor: default;
  }

  .nav-link--disabled small {
    font-size: 0.75em;
  }

  /* --- Desktop: logo arriba, nav horizontal debajo, sin hamburguesa --- */
  @media (min-width: 768px) {
    .nav-toggle {
      display: none;
    }

    .header-top {
      min-height: auto;
    }

    .main-nav {
      display: block; /* ya no depende de .open */
      position: static;
      width: auto;
      background: none;
      box-shadow: none;
      padding: var(--space-sm, 0.75rem) 0 0;
      border-top: none;
      margin-top: var(--space-xs, 0.5rem);
      transition:
        padding 0.3s ease,
        margin 0.3s ease;
    }

    .main-nav ul {
      display: flex;
      flex-direction: row;
      justify-content: center;
      align-items: center;
      gap: var(--space-md, 1.5rem);
      list-style: none;
    }

    header.scrolled .main-nav {
      padding-top: 0.25rem;
      margin-top: 0;
    }
  }
</style>
<script is:inline>
  const header = document.getElementById("site-header");
  const toggle = document.getElementById("nav-toggle");
  const nav = document.getElementById("main-nav");

  toggle?.addEventListener("click", () => {
    if (!nav) return;
    const isOpen = nav.classList.toggle("open");
    toggle.setAttribute("aria-expanded", String(isOpen));
  });

  document.addEventListener("click", (e) => {
    if (!nav || !nav.classList.contains("open")) return;
    const target = e.target;
    if (!(target instanceof Node)) return;
    if (nav.contains(target) || toggle?.contains(target)) return;
    nav.classList.remove("open");
    toggle?.setAttribute("aria-expanded", "false");
  });

  // Histéresis: el rango entre ENTER y EXIT debe ser mayor que el salto de
  // altura que produce el header al encogerse (9rem -> 3.5rem ≈ 88px),
  // para que el cambio de scrollY causado por el propio colapso no pueda
  // cruzar ambos umbrales y generar un loop de parpadeo.
  const SCROLL_ENTER = 220;
  const SCROLL_EXIT = 20;
  let ticking = false;

  function updateHeaderState() {
    if (!header) return;
    const y = window.scrollY;
    if (y > SCROLL_ENTER) {
      header.classList.add("scrolled");
    } else if (y < SCROLL_EXIT) {
      header.classList.remove("scrolled");
    }
    ticking = false;
  }

  window.addEventListener(
    "scroll",
    () => {
      if (!ticking) {
        requestAnimationFrame(updateHeaderState);
        ticking = true;
      }
    },
    { passive: true },
  );

  updateHeaderState();
</script>
