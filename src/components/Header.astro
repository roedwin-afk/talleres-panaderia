---
import { Image } from "astro:assets";
import logo from "../assets/editable-logo-equipoypartes.webp";
import { menu, categorias } from "../data/categorias";

interface Props {
  nombreEmpresa: string;
}

const { nombreEmpresa } = Astro.props;
const base = import.meta.env.BASE_URL;

// En la raíz (el hub) mostramos las categorías activas + Contacto.
// Dentro de una categoría (o de un taller) mostramos las anclas de esa
// página (Formulario, Talleres Anteriores, FAQ) + Contacto, como antes.
const esRaiz = Astro.url.pathname === base;
const categoriasActivas = categorias.filter((categoria) => categoria.activa);

const contactoHref = `${base}contacto/`;
const contactoActivo = Astro.url.pathname.startsWith(contactoHref);
---

<header id="site-header">
  <div class="container header-content">
    <div class="header-top">
      <button
        id="nav-toggle"
        class="nav-toggle"
        aria-label="Abrir menú"
        aria-expanded="false"
      >
        <span></span><span></span><span></span>
      </button>

      <a href={base} class="logo">
        <Image
          src={logo}
          alt={nombreEmpresa}
          width={200}
          height={184}
          class="navbar__logo-img"
        />
      </a>
    </div>

    <nav id="main-nav" class="main-nav">
      <ul>
        {
          esRaiz
            ? categoriasActivas.map((categoria) => {
                const href = `${base}talleres/${categoria.id}/`;
                return (
                  <li>
                    <a href={href} class="nav-link">
                      {categoria.nombre}
                    </a>
                  </li>
                );
              })
            : menu.map((cat) => {
                const href = `${base}#${cat.tag}`;
                const activo = Astro.url.pathname.startsWith(href);
                return (
                  <li>
                    <a href={href} class:list={["nav-link", { activo }]}>
                      {cat.nombre}
                    </a>
                  </li>
                );
              })
        }
        <li>
          <a
            href={contactoHref}
            class:list={["nav-link", { activo: contactoActivo }]}
          >
            Contacto
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  header {
    background-color: var(--bg-surface);
    padding: var(--space-xs) 0;
    box-shadow: var(--shadow-sm);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .header-content {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .header-top {
    position: relative;
    width: 100%;
    height: 3.25rem;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .logo {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .navbar__logo-img {
    display: block;
    height: 2.75rem;
    width: auto;
  }

  .nav-toggle {
    display: flex;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    position: absolute;
    top: 50%;
    left: 0.5rem;
    transform: translateY(-50%);
    z-index: 10;
  }

  .nav-toggle span {
    width: 24px;
    height: 2px;
    background-color: var(--text-main);
  }

  /* --- El menú es un dropdown flotante en mobile: no empuja el contenido --- */
  .main-nav {
    display: none;
  }

  .main-nav.open {
    display: block;
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    background: var(--bg-surface);
    box-shadow: var(--shadow-md, 0 8px 20px rgba(0, 0, 0, 0.15));
    padding: var(--space-md);
    z-index: 99;
    border-top: 1px solid var(--border, rgba(0, 0, 0, 0.08));
  }

  .main-nav.open ul {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
    list-style: none;
  }

  .nav-link {
    color: var(--text-main);
    text-decoration: none;
    font-weight: 600;
    padding: 0.4rem 0;
    border-bottom: 2px solid transparent;
    transition:
      border-color var(--transition-speed),
      color var(--transition-speed);
  }

  .nav-link:hover {
    color: var(--brand-primary);
  }

  .nav-link.activo {
    color: var(--brand-primary);
    border-bottom-color: var(--brand-primary);
  }

  /* --- Desktop: logo arriba, nav horizontal debajo, sin hamburguesa --- */
  @media (min-width: 768px) {
    .nav-toggle {
      display: none;
    }

    .main-nav {
      display: block; /* ya no depende de .open */
      position: static;
      width: auto;
      background: none;
      box-shadow: none;
      padding: var(--space-xs, 0.5rem) 0 0;
      border-top: none;
    }

    .main-nav ul {
      display: flex;
      flex-direction: row;
      justify-content: center;
      align-items: center;
      gap: var(--space-md, 1.5rem);
      list-style: none;
    }
  }
</style>
<script is:inline>
  const toggle = document.getElementById("nav-toggle");
  const nav = document.getElementById("main-nav");

  toggle?.addEventListener("click", () => {
    if (!nav) return;
    const isOpen = nav.classList.toggle("open");
    toggle.setAttribute("aria-expanded", String(isOpen));
  });

  document.addEventListener("click", (e) => {
    if (!nav || !nav.classList.contains("open")) return;
    const target = e.target;
    if (!(target instanceof Node)) return;
    if (nav.contains(target) || toggle?.contains(target)) return;
    nav.classList.remove("open");
    toggle?.setAttribute("aria-expanded", "false");
  });
</script>