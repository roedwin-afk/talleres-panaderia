---
import { Image } from "astro:assets";
import logo from "../assets/editable-logo-equipoypartes.webp";
import { menu, categorias } from "../data/categorias";

interface Props {
  nombreEmpresa: string;
}

const { nombreEmpresa } = Astro.props;
const base = import.meta.env.BASE_URL;

// En la raíz (el hub) mostramos las categorías activas + Contacto.
// Dentro de una categoría (o de un taller) mostramos las anclas de esa
// página (Formulario, Talleres Anteriores, FAQ) + Contacto, como antes.

// Normalizamos ambos lados quitando la barra final, para que la comparación
// no falle por diferencias de trailing slash.
const normalizar = (p: string) => (p.endsWith("/") ? p.slice(0, -1) : p);
const pathnameActual = Astro.url.pathname;
const contactoHref = `${base}contacto/`;
const contactoActivo = normalizar(pathnameActual).startsWith(
  normalizar(contactoHref),
);

const esRaiz = normalizar(pathnameActual) === normalizar(base);

// Las anclas del menú (Talleres, Formulario, Talleres Anteriores, FAQ)
// viven en la página de categoría (/talleres/{categoria}/), no en el
// detalle de un taller individual. Si estamos dentro de un taller
// (/talleres/{categoria}/{slug}/), estas anclas deben apuntar de vuelta
// a la página de categoría, no a la página actual — si no, el navegador
// busca el ancla dentro del detalle, donde no existe.
const talleresPrefix = `${base}talleres/`;
let categoriaPathname = pathnameActual;
if (pathnameActual.startsWith(talleresPrefix)) {
  const resto = pathnameActual.slice(talleresPrefix.length);
  const categoriaId = resto.split("/")[0];
  if (categoriaId) {
    categoriaPathname = `${talleresPrefix}${categoriaId}/`;
  }
}

// La página de Contacto tampoco tiene las anclas (#formulario,
// #talleres-anteriores, #faq) — esas solo existen dentro de una página de
// categoría o de un taller. Así que en Contacto debe mostrarse la misma
// lista de categorías que en la raíz, no el menú de anclas (que ahí
// apuntaría a secciones inexistentes).
const mostrarCategorias = esRaiz || contactoActivo;

const categoriasActivas = categorias.filter((categoria) => categoria.activa);

// El estado "activo" de un ancla se determina por el hash actual de la URL,
// no por el pathname (el pathname nunca contiene el fragmento #...).
const hashActual = Astro.url.hash; // ej: "#formulario" o ""
---

<header id="site-header">
  <div class="container header-content">
    <button
      id="nav-toggle"
      class="nav-toggle"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="main-nav"
    >
      <span></span><span></span><span></span>
    </button>

    <div class="header-top">
      <a href={base} class="logo">
        <Image
          src={logo}
          alt={nombreEmpresa}
          width={200}
          height={184}
          class="navbar__logo-img"
        />
      </a>
    </div>

    <nav id="main-nav" class="main-nav">
      <ul>
        {
          mostrarCategorias
            ? categoriasActivas.map((categoria) => {
                const href = `${base}talleres/${categoria.id}/`;
                return (
                  <li>
                    <a href={href} class="nav-link">
                      {categoria.nombre}
                    </a>
                  </li>
                );
              })
            : menu.map((cat) => {
                // El ancla apunta a la página de categoría, no a la
                // página actual (que puede ser el detalle de un taller).
                const href = `${categoriaPathname}#${cat.tag}`;
                const activo = hashActual === `#${cat.tag}`;
                return (
                  <li>
                    <a href={href} class:list={["nav-link", { activo }]}>
                      {cat.nombre}
                    </a>
                  </li>
                );
              })
        }
        <li>
          <a
            href={contactoHref}
            class:list={["nav-link", { activo: contactoActivo }]}
          >
            Contacto
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  header {
    background-color: var(--bg-surface);
    padding: var(--space-xs) 0;
    box-shadow: var(--shadow-sm);
    position: sticky;
    top: 0;
    z-index: 100;
    transition: box-shadow var(--transition-speed);
    overflow-anchor: none;
  }

  .header-content {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .header-top {
    position: relative;
    width: 100%;
    height: 6rem;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
    transition: height 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .logo {
    display: flex;
    align-items: center;
    justify-content: center;
    transition:
      opacity 0.3s ease,
      transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    transform-origin: center top;
  }

  #site-header.header--compact .header-top {
    height: 0;
  }

  #site-header.header--compact .logo {
    opacity: 0;
    transform: scale(0.55) translateY(-8px);
    pointer-events: none;
  }

  .navbar__logo-img {
    display: block;
    height: 5.5rem;
    width: auto;
  }

  .nav-toggle {
    display: flex;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    position: absolute;
    top: 0.6rem;
    left: 0.5rem;
    z-index: 10;
  }

  .nav-toggle span {
    width: 24px;
    height: 2px;
    background-color: var(--text-main);
  }

  /* --- El menú es un dropdown flotante en mobile: no empuja el contenido --- */
  .main-nav {
    display: none;
  }

  .main-nav.open {
    display: block;
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    background: var(--bg-surface);
    box-shadow: var(--shadow-md, 0 8px 20px rgba(0, 0, 0, 0.15));
    padding: var(--space-md);
    z-index: 99;
    border-top: 1px solid var(--border, rgba(0, 0, 0, 0.08));
  }

  .main-nav.open ul {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
    list-style: none;
  }

  .nav-link {
    color: var(--text-main);
    text-decoration: none;
    font-weight: 600;
    padding: 0.4rem 0;
    border-bottom: 2px solid transparent;
    transition:
      border-color var(--transition-speed),
      color var(--transition-speed);
  }

  .nav-link:hover {
    color: var(--brand-primary);
  }

  .nav-link.activo {
    color: var(--brand-primary);
    border-bottom-color: var(--brand-primary);
  }

  /* --- Desktop: logo arriba, nav horizontal debajo, sin hamburguesa --- */
  @media (min-width: 768px) {
    .nav-toggle {
      display: none;
    }

    .main-nav {
      display: block; /* ya no depende de .open */
      position: static;
      width: auto;
      background: none;
      box-shadow: none;
      padding: var(--space-xs, 0.5rem) 0 0;
      border-top: none;
    }

    .main-nav ul {
      display: flex;
      flex-direction: row;
      justify-content: center;
      align-items: center;
      gap: var(--space-md, 1.5rem);
      list-style: none;
    }
  }
</style>
<script is:inline>
  const toggle = document.getElementById("nav-toggle");
  const nav = document.getElementById("main-nav");

  toggle?.addEventListener("click", () => {
    if (!nav) return;
    const isOpen = nav.classList.toggle("open");
    toggle.setAttribute("aria-expanded", String(isOpen));
  });

  document.addEventListener("click", (e) => {
    if (!nav || !nav.classList.contains("open")) return;
    const target = e.target;
    if (!(target instanceof Node)) return;
    if (nav.contains(target) || toggle?.contains(target)) return;
    nav.classList.remove("open");
    toggle?.setAttribute("aria-expanded", "false");
  });
  // --- Ocultar el logo al hacer scroll hacia abajo, mostrarlo al subir ---
  // Usamos posición absoluta de scroll con histéresis (dos umbrales distintos
  // para entrar y salir del modo compacto) en vez de acumular delta. El delta
  // por evento de scroll no es limpio (momentum scrolling, trackpads) y
  // reiniciar el acumulado en cada micro-cambio de dirección producía
  // parpadeo: la clase se agregaba y quitaba varias veces por segundo,
  // cortando la transición CSS a mitad de camino cada vez.
  const header = document.getElementById("site-header");

  if (header) {
    const ENTRAR_COMPACTO = 160; // px de scroll para colapsar el logo
    const SALIR_COMPACTO = 80; // px de scroll para volver a mostrarlo (< ENTRAR_COMPACTO a propósito)

    let compacto = false;
    let ticking = false;

    // El header cambia de alto entre su estado expandido y compacto
    // (y con el menú móvil abierto/cerrado). Esta variable la usan las
    // secciones-ancla (scroll-padding-top en talleres-tokens.css) para
    // no quedar tapadas por el header sticky al llegar por un enlace #.
    const actualizarAlturaHeader = () => {
      document.documentElement.style.setProperty(
        "--header-height",
        `${header.offsetHeight}px`,
      );
    };

    const actualizarHeader = () => {
      const y = window.scrollY;

      if (!compacto && y > ENTRAR_COMPACTO) {
        compacto = true;
        header.classList.add("header--compact");
      } else if (compacto && y < SALIR_COMPACTO) {
        compacto = false;
        header.classList.remove("header--compact");
      }

      actualizarAlturaHeader();
      ticking = false;
    };

    actualizarAlturaHeader();
    window.addEventListener("resize", actualizarAlturaHeader, { passive: true });
    // La altura cambia con una transición CSS (0.35s); se vuelve a medir
    // al terminar para que quede exacta también en el estado final.
    header.addEventListener("transitionend", actualizarAlturaHeader);

    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          requestAnimationFrame(actualizarHeader);
          ticking = true;
        }
      },
      { passive: true },
    );
  }
</script>