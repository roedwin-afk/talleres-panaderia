  .form-container h3 {
    margin-bottom: var(--space-xs);
    text-align: center;
    font-size: 1.8rem;
  }

  .form-desc {
    text-align: center;
    color: var(--text-muted);
    margin-bottom: var(--space-md);
    font-size: 0.95rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-sm);
  }

  .form-group {
    margin-bottom: var(--space-sm);
  }

  .form-label {
    display: block;
    margin-bottom: 0.5rem;
    font-weight: 600;
    font-size: 0.95rem;
