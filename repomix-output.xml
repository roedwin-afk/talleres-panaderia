    margin-top: 1rem;
  }
  @media (max-width: 600px) {
    .form-container {
      padding: var(--space-md) var(--space-sm);
    }
  }
</style>

<script>
  // Envío mock por ahora — se conecta a Power Automate + Zoho Sheet más adelante.
  const form = document.getElementById(
    "form-preinscripcion",
  ) as HTMLFormElement | null;

  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    alert(
      "Gracias por tu preinscripción. Un asesor se comunicará contigo pronto.",
    );
    form.reset();
  });

  // Pre-selección vía query param (?taller=slug), usado desde TarjetaTaller
  // cuando el formulario general (con <select>) está en la misma página.
  const params = new URLSearchParams(window.location.search);
  const tallerParam = params.get("taller");
  const select = document.getElementById(
    "workshop-select",
  ) as HTMLSelectElement | null;
  if (tallerParam && select) {
    select.value = tallerParam;
