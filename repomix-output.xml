    '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"/><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"/></svg>',
  tiktok:
    '<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M16.6 5.82c-.9-.98-1.4-2.25-1.4-3.57h-3.15v13.2a2.7 2.7 0 1 1-2.32-2.68v-3.2A5.85 5.85 0 0 0 6.5 21.85 5.85 5.85 0 0 0 15.3 17v-6.62a8.14 8.14 0 0 0 4.76 1.53V8.76a4.85 4.85 0 0 1-3.46-2.94z"/></svg>',
};

const whatsappHref = 'https://wa.me/' + telefonoWhatsapp;
const mailHref = 'mailto:' + correo;

const sucursalesBase = [
  {
    nombre: 'San Salvador',
    direccion: 'Calle Roma y Calle Lorena #170, San Salvador.',
    horario: [
      'Lunes - Viernes: 8:00 a.m. - 5:00 p.m.',
      'Sábado: 8:00 a.m. - 4:00 p.m.',
      'Domingo: Cerrado',
    ],
  },
  {
    nombre: 'San Miguel',
    direccion:
      'Carretera Panamericana, 500 metros de Metrocentro. Ex local Zócalo, San Miguel.',
    horario: [
      'Lunes - Viernes: 8:00 a.m. - 5:00 p.m.',
      'Sábado: 8:00 a.m. - 12:00 m.d.',
      'Domingo: Cerrado',
    ],
  },
];

// Se precalculan aquí (y no dentro del markup) para no tener URLs sueltas
// mezcladas con atributos JSX, que es justo lo que se rompió la vez pasada.
const sucursales = sucursalesBase.map((sucursal) => {
  const direccionCompleta = sucursal.direccion + ' El Salvador';
  const direccionCodificada = encodeURIComponent(direccionCompleta);
  return {
    ...sucursal,
    mapEmbedSrc:
      'https://www.google.com/maps?q=' +
      direccionCodificada +
      '&output=embed',
    mapsUrl:
      'https://www.google.com/maps/search/' + direccionCodificada,
  };
});
---

<Layout
  title="Contacto | Equipo y Partes El Salvador"
  description="Visítanos, escríbenos o síguenos en redes sociales. Sucursales en San Salvador y San Miguel."
>
  <section class="contacto-hero">
    <div class="container">
      <h1>Hablemos</h1>
      <span class="hero-acento" aria-hidden="true"></span>
      <p>
        Escríbenos por cualquier duda sobre nuestros talleres, o visítanos en
        cualquiera de nuestras sucursales.
      </p>
    </div>
  </section>

  <section class="info-directa">
    <div class="container">
      <div class="grid grid-info">
        <a class="info-card" href={whatsappHref} target="_blank" rel="noopener">
          <span class="info-icon" set:html={ICONOS.telefono} />
          <div>
            <h3>Llámanos o escríbenos por WhatsApp</h3>
            <p>{telefono}</p>
          </div>
        </a>

        <a class="info-card" href={mailHref}>
          <span class="info-icon" set:html={ICONOS.correo} />
          <div>
            <h3>Escríbenos</h3>
            <p>{correo}</p>
          </div>
        </a>
      </div>

      <div class="redes">
        <span class="redes-label">Síguenos</span>
        <div class="redes-lista">
          {
            redes.map((red) => (
              <a
                href={red.url}
                target="_blank"
                rel="noopener"
                class="red-icono"
                aria-label={red.nombre}
                set:html={ICONOS[red.icono]}
              />
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="sucursales">
    <div class="container">
      <div class="section-header">
        <h2>Visítanos</h2>
        <p>Dos sucursales para atenderte mejor.</p>
      </div>

      <div class="grid">
        {
          sucursales.map((sucursal) => (
            <div class="sucursal-card">
              <iframe
                class="sucursal-mapa"
                title={"Mapa - " + sucursal.nombre}
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                src={sucursal.mapEmbedSrc}
              />
              <div class="sucursal-body">
                <h3>{sucursal.nombre}</h3>
                <p class="sucursal-direccion">
                  <span class="info-icon-sm" set:html={ICONOS.pin} />
                  {sucursal.direccion}
                </p>
                <ul class="sucursal-horario">
                  {sucursal.horario.map((linea) => (
                    <li>{linea}</li>
                  ))}
                </ul>
                <a
                  class="btn btn-outline btn-block"
                  href={sucursal.mapsUrl}
                  target="_blank"
                  rel="noopener"
                >
                  Cómo llegar
                </a>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="dudas">
    <div class="container">
      <div class="form-container">
        <h2>¿Tienes alguna duda?</h2>
        <p class="form-desc">
          Mándanos tu consulta y te respondemos a la brevedad.
        </p>

        <form id="form-dudas">
          <div class="form-group">
            <label for="duda-nombre" class="form-label">Nombre</label>
            <input
              type="text"
              id="duda-nombre"
              name="nombre"
              class="form-control"
              placeholder="Ej. Juan Pérez"
              required
            />
          </div>

          <div class="form-group">
            <label for="duda-correo" class="form-label"
              >Correo electrónico</label
            >
            <input
              type="email"
              id="duda-correo"
              name="correo"
              class="form-control"
              placeholder="ejemplo@correo.com"
              required
            />
          </div>

          <div class="form-group">
            <label for="duda-mensaje" class="form-label">Mensaje</label>
            <textarea
              id="duda-mensaje"
              name="mensaje"
              class="form-control"
              rows="4"
              placeholder="Cuéntanos en qué te podemos ayudar"
              required
            ></textarea>
          </div>

          <button type="submit" class="btn btn-primary btn-block">
            Enviar mensaje
          </button>
        </form>
      </div>
    </div>
  </section>
</Layout>

<script is:inline>
  const form = document.getElementById("form-dudas");
  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    alert("Gracias por escribirnos. Te responderemos pronto.");
    form.reset();
  });
</script>

