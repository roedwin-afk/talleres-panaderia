// Se precalculan aquí (y no dentro del markup) para no tener URLs sueltas
// mezcladas con atributos JSX, que es justo lo que se rompió la vez pasada.
const sucursales = sucursalesBase.map((sucursal) => {
  const direccionCompleta = sucursal.direccion + ' El Salvador';
  const direccionCodificada = encodeURIComponent(direccionCompleta);
  return {
    ...sucursal,
    mapEmbedSrc:
      'https://www.google.com/maps?q=' +
      direccionCodificada +
      '&output=embed',
    mapsUrl:
      'https://www.google.com/maps/search/' + direccionCodificada,
  };
});
---

<Layout
  title="Contacto | Equipo y Partes El Salvador"
  description="Visítanos, escríbenos o síguenos en redes sociales. Sucursales en San Salvador y San Miguel."
>
  <section class="contacto-hero">
    <div class="container">
      <h1>Hablemos</h1>
      <span class="hero-acento" aria-hidden="true"></span>
      <p>
        Escríbenos por cualquier duda sobre nuestros talleres, o visítanos en
        cualquiera de nuestras sucursales.
      </p>
    </div>
  </section>

  <section class="info-directa">
    <div class="container">
      <div class="grid grid-info">
        <a class="info-card" href={whatsappHref} target="_blank" rel="noopener">
          <span class="info-icon" set:html={ICONOS.telefono} />
          <div>
            <h3>Llámanos o escríbenos por WhatsApp</h3>
            <p>{telefono}</p>
          </div>
        </a>

        <a class="info-card" href={mailHref}>
          <span class="info-icon" set:html={ICONOS.correo} />
          <div>
            <h3>Escríbenos</h3>
            <p>{correo}</p>
          </div>
        </a>
      </div>

      <div class="redes">
        <span class="redes-label">Síguenos</span>
        <div class="redes-lista">
          {
            redes.map((red) => (
              <a
                href={red.url}
                target="_blank"
                rel="noopener"
                class="red-icono"
                aria-label={red.nombre}
                set:html={ICONOS[red.icono]}
              />
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="sucursales">
    <div class="container">
      <div class="section-header">
        <h2>Visítanos</h2>
        <p>Dos sucursales para atenderte mejor.</p>
      </div>

      <div class="grid">
        {
          sucursales.map((sucursal) => (
            <div class="sucursal-card">
              <iframe
                class="sucursal-mapa"
                title={"Mapa - " + sucursal.nombre}
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                src={sucursal.mapEmbedSrc}
              />
              <div class="sucursal-body">
                <h3>{sucursal.nombre}</h3>
                <p class="sucursal-direccion">
                  <span class="info-icon-sm" set:html={ICONOS.pin} />
                  {sucursal.direccion}
                </p>
                <ul class="sucursal-horario">
                  {sucursal.horario.map((linea) => (
                    <li>{linea}</li>
                  ))}
                </ul>
                <a
                  class="btn btn-outline btn-block"
                  href={sucursal.mapsUrl}
                  target="_blank"
                  rel="noopener"
                >
                  Cómo llegar
                </a>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="dudas">
    <div class="container">
      <div class="form-container">
        <h2>¿Tienes alguna duda?</h2>
        <p class="form-desc">
          Mándanos tu consulta y te respondemos a la brevedad.
        </p>

        <form id="form-dudas">
          <div class="form-group">
            <label for="duda-nombre" class="form-label">Nombre</label>
            <input
              type="text"
              id="duda-nombre"
              name="nombre"
              class="form-control"
              placeholder="Ej. Juan Pérez"
              required
            />
          </div>

          <div class="form-group">
            <label for="duda-correo" class="form-label"
              >Correo electrónico</label
            >
            <input
              type="email"
              id="duda-correo"
              name="correo"
              class="form-control"
              placeholder="ejemplo@correo.com"
              required
            />
          </div>

          <div class="form-group">
            <label for="duda-mensaje" class="form-label">Mensaje</label>
            <textarea
              id="duda-mensaje"
              name="mensaje"
              class="form-control"
              rows="4"
              placeholder="Cuéntanos en qué te podemos ayudar"
              required
            ></textarea>
          </div>

          <button type="submit" class="btn btn-primary btn-block">
            Enviar mensaje
          </button>
        </form>
      </div>
    </div>
  </section>
</Layout>

<script is:inline>
  const form = document.getElementById("form-dudas");
