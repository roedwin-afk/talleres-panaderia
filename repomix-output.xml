  .form-label em {
    color: var(--status-few);
    font-style: normal;
  }

  .form-control {
    width: 100%;
    padding: 0.75rem;
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    font-family: var(--font-family-body);
    font-size: 1rem;
    transition: border-color var(--transition-speed);
  }

  .form-control:focus {
    outline: none;
    border-color: var(--brand-primary);
    box-shadow: 0 0 0 3px rgba(192, 86, 33, 0.1);
  }

  .form-control-static {
    background-color: var(--bg-surface-alt);
    font-weight: 600;
    color: var(--text-main);
  }

  .form-note {
    text-align: center;
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-top: 1rem;
  }

  @media (max-width: 600px) {
    .form-container {
      padding: var(--space-md) var(--space-sm);
    }
    .form-row {
      grid-template-columns: 1fr;
    }
  }
</style>

<script is:inline>
  document.addEventListener("DOMContentLoaded", function () {
    var params = new URLSearchParams(window.location.search);
    var tallerParam = params.get("taller");
    var select = document.getElementById("Dropdown");
    if (tallerParam && select && select.tagName === "SELECT") {
      for (var i = 0; i < select.options.length; i++) {
        if (
          select.options[i].value
            .toLowerCase()
            .indexOf(tallerParam.toLowerCase()) !== -1
        ) {
          select.value = select.options[i].value;
          break;
        }
      }
    }
    var referrerInput = document.querySelector(
      'input[name="zf_referrer_name"]',
    );
    if (referrerInput) referrerInput.value = window.location.href;
  });
</script>
