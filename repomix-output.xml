  /* Arco decorativo, esquina inferior izquierda */
  .hub-hero-arco {
    position: absolute;
    left: -140px;
    bottom: -140px;
    width: 280px;
    height: 280px;
    border-radius: 50%;
    border: 1px solid rgba(253, 122, 24, 0.4);
    z-index: 0;
  }

  /* Patrón de puntos, esquina superior derecha */
  .hub-hero-dots {
    position: absolute;
    top: 0;
    right: 0;
    width: 280px;
    height: 280px;
    background-image: radial-gradient(
      circle at 1px 1px,
      rgba(253, 155, 75, 0.55) 1.5px,
      transparent 0
    );
    background-size: 18px 18px;
    -webkit-mask-image: radial-gradient(
      circle at top right,
      black 0%,
      transparent 75%
    );
