<file path="src/components/TalleresAnteriores.astro">
---
import { Image, getImage } from "astro:assets";
import type { TallerAnterior } from "../data/content";

interface Props {
  items: TallerAnterior[];
}
const { items } = Astro.props;

// Pre-generamos versiones optimizadas (más grandes) de cada foto para el modal,
// en build time. El thumbnail usa <Image /> directamente más abajo.
const galerias = await Promise.all(
  items.map(async (item) => {
    const fotos = item.imagenes?.length ? item.imagenes : [item.imagen];
    const optimizadas = await Promise.all(
      fotos.map((foto) => getImage({ src: foto, width: 1200, format: "webp" }))
    );
    return optimizadas.map((img) => img.src);
  })
);
---

<section id="talleres-anteriores" class="galeria-section">
  <div class="container">
    <div class="section-header">
      <span class="eyebrow">Así se viven nuestros talleres</span>
      <h2>Aprende haciendo y conoce equipos profesionales</h2>
      <p>
        Vive una experiencia práctica donde aprenderás nuevas preparaciones
        mientras conoces maquinaria que facilita y agiliza el trabajo.
      </p>
    </div>

    <div class="grid galeria-grid">
      {
        items.map((item, i) => (
          <figure class="galeria-item">
            <button
              type="button"
              class="galeria-trigger"
              data-index={i}
              data-titulo={item.titulo}
              data-imagenes={JSON.stringify(galerias[i])}
              aria-label={`Ver galería de ${item.titulo}`}
            >
              <div
                class="galeria-imagen-wrap"
                style={`background-image: url('${item.imagen.src}');`}
              >
                <Image
                  src={item.imagen}
                  alt={item.titulo}
                  width={480}
                  height={220}
                  loading="lazy"
                />
                {galerias[i].length > 1 && (
                  <span class="galeria-badge">+{galerias[i].length} fotos</span>
                )}
                {galerias[i].length === 1 && (
                  <span class="galeria-badge">Ver foto</span>
                )}
              </div>
              <figcaption>{item.titulo}</figcaption>
            </button>
          </figure>
        ))
      }
    </div>
  </div>

  <!-- Modal / Lightbox (sin cambios respecto a la versión anterior) -->
  <div id="galeria-modal" class="galeria-modal" hidden>
    <div class="galeria-modal-backdrop" data-close></div>
    <div class="galeria-modal-content" role="dialog" aria-modal="true" aria-label="Galería de fotos">
      <button type="button" class="galeria-modal-close" data-close aria-label="Cerrar">
        &times;
      </button>
      <button type="button" class="galeria-modal-nav galeria-modal-prev" aria-label="Foto anterior">
        &#8249;
      </button>
      <div class="galeria-modal-body">
        <img id="galeria-modal-img" src="" alt="" />
        <p id="galeria-modal-titulo" class="galeria-modal-titulo"></p>
        <p id="galeria-modal-counter" class="galeria-modal-counter"></p>
      </div>
      <button type="button" class="galeria-modal-nav galeria-modal-next" aria-label="Foto siguiente">
        &#8250;
      </button>
    </div>
  </div>
</section>

<style>
  .galeria-section {
    padding: var(--space-lg) 0;
  }

  .eyebrow {
    display: block;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brand-primary);
    margin-bottom: var(--space-xs);
  }

  .galeria-grid {
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }

  .galeria-item {
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .galeria-item img {
    position: relative;
    z-index: 1;
    max-height: 220px;
    max-width: 100%;
    width: auto;
    height: auto;
    margin: 0 auto;
    object-fit: contain;
    display: block;
  }

  .galeria-imagen-wrap {
    position: relative;
    height: 220px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background-size: cover;
    background-position: center;
  }

  .galeria-imagen-wrap::before {
    content: "";
    position: absolute;
    inset: 0;
    background: inherit;
    background-size: cover;
    background-position: center;
    filter: blur(14px) brightness(0.7);
    transform: scale(1.15); /* evita bordes borrosos visibles por el blur */
    z-index: 0;
  }

  .galeria-item figcaption {
    padding: var(--space-sm);
    background-color: var(--bg-surface);
    font-weight: 600;
    font-size: 0.95rem;
    text-align: center;
    flex-grow: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }
</style>
</file>

<file path="src/components/Header.astro">
---
import { Image } from "astro:assets";
import logo from "../assets/editable-logo-equipoypartes.webp";
import { menu, categorias } from "../data/categorias";

interface Props {
  nombreEmpresa: string;
}

const { nombreEmpresa } = Astro.props;
const base = import.meta.env.BASE_URL;

// En la raíz (el hub) mostramos las categorías activas + Contacto.
// Dentro de una categoría (o de un taller) mostramos las anclas de esa
// página (Formulario, Talleres Anteriores, FAQ) + Contacto, como antes.

// Normalizamos ambos lados quitando la barra final, para que la comparación
// no falle por diferencias de trailing slash.
const normalizar = (p: string) => (p.endsWith("/") ? p.slice(0, -1) : p);
const pathnameActual = Astro.url.pathname;
const contactoHref = `${base}contacto/`;
const contactoActivo = normalizar(pathnameActual).startsWith(
  normalizar(contactoHref),
);

const esRaiz = normalizar(pathnameActual) === normalizar(base);

// La página de Contacto tampoco tiene las anclas (#formulario,
// #talleres-anteriores, #faq) — esas solo existen dentro de una página de
// categoría o de un taller. Así que en Contacto debe mostrarse la misma
// lista de categorías que en la raíz, no el menú de anclas (que ahí
// apuntaría a secciones inexistentes).
const mostrarCategorias = esRaiz || contactoActivo;

const categoriasActivas = categorias.filter((categoria) => categoria.activa);

// El estado "activo" de un ancla se determina por el hash actual de la URL,
// no por el pathname (el pathname nunca contiene el fragmento #...).
const hashActual = Astro.url.hash; // ej: "#formulario" o ""
---

<header id="site-header">
  <div class="container header-content">
    <div class="header-top">
      <button
        id="nav-toggle"
        class="nav-toggle"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="main-nav"
      >
        <span></span><span></span><span></span>
      </button>

      <a href={base} class="logo">
        <Image
          src={logo}
          alt={nombreEmpresa}
          width={200}
          height={184}
          class="navbar__logo-img"
        />
      </a>
    </div>

    <nav id="main-nav" class="main-nav">
      <ul>
        {
          mostrarCategorias
            ? categoriasActivas.map((categoria) => {
                const href = `${base}talleres/${categoria.id}/`;
                return (
                  <li>
                    <a href={href} class="nav-link">
                      {categoria.nombre}
                    </a>
                  </li>
                );
              })
            : menu.map((cat) => {
                // El ancla apunta a la página ACTUAL (categoría o taller),
                // no siempre a la raíz del sitio.
                const href = `${pathnameActual}#${cat.tag}`;
                const activo = hashActual === `#${cat.tag}`;
                return (
                  <li>
                    <a href={href} class:list={["nav-link", { activo }]}>
                      {cat.nombre}
                    </a>
                  </li>
                );
              })
        }
        <li>
          <a
            href={contactoHref}
            class:list={["nav-link", { activo: contactoActivo }]}
          >
            Contacto
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  header {
    background-color: var(--bg-surface);
    padding: var(--space-xs) 0;
    box-shadow: var(--shadow-sm);
    position: sticky;
    top: 0;
    z-index: 100;
    transition: box-shadow var(--transition-speed);
    overflow-anchor: none;
  }

  .header-content {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .header-top {
    position: relative;
    width: 100%;
    height: 9.25rem;
    display: flex;
    justify-content: center;
    align-items: center;
    transition: height 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .logo {
    display: flex;
    align-items: center;
    justify-content: center;
    transition:
      opacity 0.3s ease,
      transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    transform-origin: center top;
  }

  #site-header.header--compact .header-top {
    height: 2.0rem;
  }

  #site-header.header--compact .logo {
    opacity: 0;
    transform: scale(0.55) translateY(-8px);
    pointer-events: none;
  }

  .navbar__logo-img {
    display: block;
    height: 8.75rem;
    width: auto;
  }

  .nav-toggle {
    display: flex;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    position: absolute;
    top: 50%;
    left: 0.5rem;
    transform: translateY(-50%);
    z-index: 10;
  }

  .nav-toggle span {
    width: 24px;
    height: 2px;
    background-color: var(--text-main);
  }

  /* --- El menú es un dropdown flotante en mobile: no empuja el contenido --- */
  .main-nav {
    display: none;
  }

  .main-nav.open {
    display: block;
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    background: var(--bg-surface);
    box-shadow: var(--shadow-md, 0 8px 20px rgba(0, 0, 0, 0.15));
    padding: var(--space-md);
    z-index: 99;
    border-top: 1px solid var(--border, rgba(0, 0, 0, 0.08));
  }

  .main-nav.open ul {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
    list-style: none;
  }

  .nav-link {
    color: var(--text-main);
    text-decoration: none;
    font-weight: 600;
    padding: 0.4rem 0;
    border-bottom: 2px solid transparent;
    transition:
      border-color var(--transition-speed),
      color var(--transition-speed);
  }

  .nav-link:hover {
    color: var(--brand-primary);
  }

  .nav-link.activo {
    color: var(--brand-primary);
    border-bottom-color: var(--brand-primary);
  }

  /* --- Desktop: logo arriba, nav horizontal debajo, sin hamburguesa --- */
  @media (min-width: 768px) {
    .nav-toggle {
      display: none;
    }

    .main-nav {
      display: block; /* ya no depende de .open */
      position: static;
      width: auto;
      background: none;
      box-shadow: none;
      padding: var(--space-xs, 0.5rem) 0 0;
      border-top: none;
    }

    .main-nav ul {
      display: flex;
      flex-direction: row;
      justify-content: center;
      align-items: center;
      gap: var(--space-md, 1.5rem);
      list-style: none;
    }
  }
</style>
<script is:inline>
  const toggle = document.getElementById("nav-toggle");
  const nav = document.getElementById("main-nav");

  toggle?.addEventListener("click", () => {
    if (!nav) return;
    const isOpen = nav.classList.toggle("open");
    toggle.setAttribute("aria-expanded", String(isOpen));
  });

  document.addEventListener("click", (e) => {
    if (!nav || !nav.classList.contains("open")) return;
    const target = e.target;
    if (!(target instanceof Node)) return;
    if (nav.contains(target) || toggle?.contains(target)) return;
    nav.classList.remove("open");
    toggle?.setAttribute("aria-expanded", "false");
  });
  // --- Ocultar el logo al hacer scroll hacia abajo, mostrarlo al subir ---
  // Usamos posición absoluta de scroll con histéresis (dos umbrales distintos
  // para entrar y salir del modo compacto) en vez de acumular delta. El delta
  // por evento de scroll no es limpio (momentum scrolling, trackpads) y
  // reiniciar el acumulado en cada micro-cambio de dirección producía
  // parpadeo: la clase se agregaba y quitaba varias veces por segundo,
  // cortando la transición CSS a mitad de camino cada vez.
  const header = document.getElementById("site-header");

  if (header) {
    const ENTRAR_COMPACTO = 160; // px de scroll para colapsar el logo
    const SALIR_COMPACTO = 80; // px de scroll para volver a mostrarlo (< ENTRAR_COMPACTO a propósito)

    let compacto = false;
    let ticking = false;

    const actualizarHeader = () => {
      const y = window.scrollY;

      if (!compacto && y > ENTRAR_COMPACTO) {
        compacto = true;
        header.classList.add("header--compact");
      } else if (compacto && y < SALIR_COMPACTO) {
        compacto = false;
        header.classList.remove("header--compact");
      }

      ticking = false;
    };

    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          requestAnimationFrame(actualizarHeader);
          ticking = true;
        }
      },
      { passive: true },
    );
  }
</script>
