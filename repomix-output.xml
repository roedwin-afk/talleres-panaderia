  }
  .detalle-contenido :global(ul) {
    padding-left: var(--space-md);
    margin-bottom: var(--space-sm);
  }

  @media (max-width: 768px) {
    .detalle-header { grid-template-columns: 1fr; }
  }
</style>
</file>

<file path="src/pages/talleres/[categoria]/[slug].astro">
---
// src/pages/talleres/[categoria]/[slug].astro
import { getCollection, render } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import ZohoFormularioHTML from "../../../components/ZohoFormularioHTML.astro";
import { categorias } from "../../../data/categorias";

export async function getStaticPaths() {
  const talleres = await getCollection("talleres");
  return talleres.map((taller) => ({
    params: { categoria: taller.data.categoria, slug: taller.id },
    props: { taller },
  }));
}

const { taller } = Astro.props;
const { Content } = await render(taller);
const base = import.meta.env.BASE_URL;

const categoriaInfo = categorias.find((c) => c.id === taller.data.categoria);

const {
  nombre,
  fecha,
  horarioInicio,
  horarioFin,
  instructor,
  instructorGenero,
  nivel,
  cuposDisponibles,
  cuposTotales,
  precio,
  imagen,
  imagenAlt,
  categoria,
} = taller.data;

const etiquetaInstructor =
  instructorGenero === "f" ? "Instructora" : "Instructor";
const fechaFormateada = fecha.toLocaleDateString("es-SV", {
  weekday: "long",
  day: "numeric",
  month: "long",
});
const precioFormateado = new Intl.NumberFormat("en-US", {
  style: "currency",
  currency: "USD",
}).format(precio);

const ICONO_CHEF =
  '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 21h8"/><path d="M9 21v-5.5"/><path d="M15 21v-5.5"/><path d="M6 10a4 4 0 0 1 1.5-7.7A4.5 4.5 0 0 1 12 2a4.5 4.5 0 0 1 4.5.3A4 4 0 0 1 18 10c1.1 0 2 .9 2 2 0 1.7-1.3 3-3 3H7c-1.7 0-3-1.3-3-3 0-1.1.9-2 2-2z"/></svg>';
---

<Layout
  title={`${nombre} | Talleres | Equipo y Partes El Salvador`}
  description={`Taller de ${nombre}, impartido por ${instructor}. ${cuposDisponibles} cupos disponibles.`}
>
  <div
    class="categoria-scope"
    style={categoriaInfo
      ? `--brand-primary: ${categoriaInfo.colorAcento}; --brand-primary-hover: color-mix(in srgb, ${categoriaInfo.colorAcento} 80%, black);`
      : ""}
  >
    <article class="detalle-taller">
      <div class="container">
        <a href={`${base}talleres/${categoria}/`} class="volver"
          >&larr; Volver a {categoriaInfo?.nombre ?? "Talleres"}</a
        >
      </div>

      <section
        class="detalle-hero"
        role="img"
        aria-label={imagenAlt}
        style={`background-image: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.75)), url('${imagen}');`}
      >
        <div class="container detalle-hero-content">
          <span class="badge badge-nivel">
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
            >
              <line x1="4" y1="20" x2="4" y2="14"></line>
              <line x1="12" y1="20" x2="12" y2="9"></line>
              <line x1="20" y1="20" x2="20" y2="4"></line>
            </svg>
            {nivel}
          </span>
          <h1>{nombre}</h1>
          <p class="detalle-instructor">
            <span class="icono-chef" set:html={ICONO_CHEF} />
            {etiquetaInstructor}: {instructor}
          </p>
          <ul class="detalle-datos">
            <li><span>Fecha:</span> <span>{fechaFormateada}</span></li>
            <li>
              <span>Horario:</span>
              <span>{horarioInicio} - {horarioFin}</span>
            </li>
            <li>
              <span>Cupos:</span>
              <span class="detalle-cupos">
                <svg
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                  <circle cx="9" cy="7" r="4"></circle>
                  <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                  <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
                {cuposDisponibles} de {cuposTotales}
              </span>
            </li>
            <li>
              <span>Precio:</span>
              <span class="detalle-precio">{precioFormateado}</span>
            </li>
          </ul>
        </div>
      </section>

      <div class="container">
        <div class="detalle-contenido">
          <Content />
        </div>
      </div>
    </article>

    <ZohoFormularioHTML tallerPreseleccionado={taller} />
  </div>
</Layout>

<style>
  .detalle-taller {
    padding-bottom: var(--space-lg);
  }
  .volver {
    display: inline-block;
    margin: var(--space-md) 0;
    color: var(--text-muted);
  }

  /* --- Hero de ancho completo (mismo tratamiento que Hero.astro) --- */
  .detalle-hero {
    background-color: var(--text-main);
    background-size: cover;
    background-position: center;
    color: var(--text-light);
    padding: var(--space-xl) 0;
    margin-bottom: var(--space-lg);
  }

  .detalle-hero-content h1 {
    color: var(--text-light);
    font-size: 2.6rem;
    font-weight: 800;
    text-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
    margin: var(--space-sm) 0 var(--space-xs);
  }

  .detalle-hero .badge-nivel {
    background-color: rgba(255, 255, 255, 0.15);
    color: var(--text-light);
    backdrop-filter: blur(2px);
  }

  .detalle-instructor {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: #e2e8f0;
    margin: 0 0 var(--space-sm);
    font-size: 1.05rem;
  }

  .icono-chef {
    display: inline-flex;
    color: var(--brand-primary);
  }

  .detalle-datos {
    list-style: none;
    max-width: 480px;
  }

  .detalle-cupos {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-weight: 600;
  }

  .detalle-datos li {
    display: flex;
    justify-content: space-between;
    padding: 0.5rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.2);
    color: #e2e8f0;
  }

  .detalle-precio {
    font-weight: 700;
    color: var(--brand-primary);
  }

  .detalle-contenido {
    max-width: 700px;
    margin: 0 0 var(--space-lg);
  }

  .detalle-contenido :global(h2) {
    color: var(--brand-primary);
    margin-top: var(--space-md);
    margin-bottom: var(--space-xs);
  }
  .detalle-contenido :global(ul) {
    padding-left: var(--space-md);
    margin-bottom: var(--space-sm);
  }

  @media (max-width: 768px) {
    .detalle-hero-content h1 {
      font-size: 2rem;
    }
  }
</style>
</file>

<file path="src/pages/talleres/[categoria]/index.astro">
---
// src/pages/talleres/[categoria]/index.astro
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import Hero from '../../../components/Hero.astro';
import ListadoTalleres from '../../../components/ListadoTalleres.astro';
import TalleresAnteriores from '../../../components/TalleresAnteriores.astro';
import Testimonios from '../../../components/Testimonios.astro';
import FAQ from '../../../components/FAQ.astro';
import ZohoFormularioHTML from '../../../components/ZohoFormularioHTML.astro';
import { categorias } from '../../../data/categorias';
import { contenidoPorCategoria } from '../../../data/content';
import ZohoFormulario from '../../../components/ZohoFormulario.astro';

export async function getStaticPaths() {
  return categorias.map((categoria) => ({
    params: { categoria: categoria.id },
    props: { categoria },
  }));
}

const { categoria } = Astro.props;
const contenido = contenidoPorCategoria[categoria.id]; // undefined si aún no hay contenido cargado

const talleresDeCategoria = contenido
  ? await getCollection('talleres', ({ data }) => data.categoria === categoria.id)
  : [];
---

<Layout
  title={`Talleres de ${categoria.nombre} | Equipo y Partes El Salvador`}
  description={categoria.descripcionCorta}
>
  <div class="categoria-scope" style={`--brand-primary: ${categoria.colorAcento}; --brand-primary-hover: color-mix(in srgb, ${categoria.colorAcento} 80%, black);`}>
    {contenido ? (
      <>
        <Hero
          titulo={contenido.heroTitulo}
          descripcion={contenido.heroDescripcion}
          textoBoton={`Conoce nuestros talleres de ${categoria.nombre}`}
          anclaBoton="#workshops"
          imagenesFondo={contenido.heroImagenesFondo}
        />
        <ListadoTalleres categoria={categoria.id} />
        <ZohoFormularioHTML talleres={talleresDeCategoria} />
        {/* <ZohoFormulario formPerma="uM5jTSyZQ1nZD8qY9C1ClM9xsGZJGDX7VEfXTWBfcZI" /> */}
        <TalleresAnteriores items={contenido.talleresAnteriores} />
        {/* <Testimonios items={contenido.testimonios} /> */}
        <FAQ items={contenido.faq} />
      </>
    ) : (
      <section class="proximamente">
        <div class="container">
          <img src={categoria.imagen} alt={categoria.nombre} class="proximamente-img" />
          <h1>Talleres de {categoria.nombre}</h1>
          <p>{categoria.descripcionCorta}</p>
          <p class="proximamente-aviso">Muy pronto vas a poder inscribirte a talleres de esta categoría. ¡Volvé pronto!</p>
          <a href={`${import.meta.env.BASE_URL}`} class="btn btn-outline">Ver otras categorías</a>
