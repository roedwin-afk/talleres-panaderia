                <p>En este taller intensivo dominarás los procesos fundamentales de preparación, leudado y horneado. Nuestro enfoque es 100% práctico.</p>
                
                <h4>Temario / Actividades:</h4>
                <ul>
                    <li>Fundamentos teóricos y formulación de recetas.</li>
                    <li>Técnicas correctas de amasado y control de temperatura.</li>
                    <li><strong>Demostración de Equipo:</strong> Pruebas de rendimiento usando nuestras amasadoras orbitales de grado industrial (Serie PRO-Mix).</li>
                    <li>Técnicas de horneado aprovechando la inyección de vapor de nuestros hornos rotativos.</li>
                </ul>

                <h4>Incluye:</h4>
                <ul>
                    <li>Materia prima completa.</li>
                    <li>Uso de delantal y herramientas.</li>
                    <li>Degustación y material impreso.</li>
                    <li>Diploma de participación firmado por nuestro Chef Instructor.</li>
                </ul>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline" onclick="closeDetailModal()">Cerrar</button>
                <button class="btn btn-primary" onclick="closeModalAndScroll()">Inscribirme ahora</button>
            </div>
        </div>
    </div>

    <!-- Funcionalidad básica JS (Interacciones UI) -->
    <script>
        const modal = document.getElementById('detail-modal');
        const modalTitle = document.getElementById('modal-title');
        const workshopSelect = document.getElementById('workshop-select');
        let currentSelectedWorkshop = "";

        // Títulos de mapeo simple para el mockup
        const workshopTitles = {
            'taller-1': 'Masa Madre y Panes Rústicos',
            'taller-2': 'Fundamentos de Pastelería',
            'taller-3': 'Pizzas Artesanales'
        };

        function openDetailModal(workshopId) {
            currentSelectedWorkshop = workshopTitles[workshopId];
            modalTitle.innerText = "Detalles: " + currentSelectedWorkshop;
            modal.classList.add('active');
            document.body.style.overflow = 'hidden'; // Evitar scroll de fondo
        }

        function closeDetailModal() {
            modal.classList.remove('active');
            document.body.style.overflow = 'auto';
        }

        function scrollToForm(workshopName) {
            // Pre-seleccionar el taller en el formulario
            if (workshopName) {
                Array.from(workshopSelect.options).forEach(option => {
                    if (option.value === workshopName) {
                        option.selected = true;
                    }
                });
            }
            
            // Hacer scroll suave hacia la sección
            document.getElementById('registration').scrollIntoView({ 
                behavior: 'smooth' 
            });
        }

        function closeModalAndScroll() {
            closeDetailModal();
            setTimeout(() => {
                scrollToForm(currentSelectedWorkshop);
            }, 300); // Esperar a que cierre el modal
        }

        // Cerrar modal al hacer clic fuera del contenido
        modal.addEventListener('click', function(e) {
            if (e.target === modal) {
                closeDetailModal();
            }
        });
    </script>
</body>
</html>
