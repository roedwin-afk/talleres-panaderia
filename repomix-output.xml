    left: -160px;
    bottom: -160px;
    width: 480px;
    height: 480px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(253, 122, 24, 0.45) 0%,
      transparent 70%
    );
    filter: blur(20px);
    z-index: 0;
